diff --git a/app/src/salida.test.ts b/app/src/salida.test.ts
new file mode 100644
index 0000000..4f8eb82
--- /dev/null
+++ b/app/src/salida.test.ts
@@ -0,0 +1,56 @@
+import { readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { describe, expect, it, vi } from 'vitest';
+import { estadoSalud } from './services/salud';
+import { limpiarDatosPersonales, registrar } from './services/logger';
+
+const raiz = resolve(__dirname, '../..');
+
+describe('secretos', () => {
+  it('gitignore-env: la raíz y app/ ignoran .env', () => {
+    for (const ruta of [resolve(raiz, '.gitignore'), resolve(raiz, 'app/.gitignore')]) {
+      const lineas = readFileSync(ruta, 'utf8').split('\n').map((l) => l.trim());
+      expect(lineas).toContain('.env');
+      expect(lineas).toContain('.env.*');
+    }
+  });
+});
+
+describe('ruta de salud', () => {
+  it('salud: estadoSalud responde ok con la versión', () => {
+    const estado = estadoSalud();
+    expect(estado.status).toBe('ok');
+    expect(typeof estado.version).toBe('string');
+  });
+
+  it('salud: /salud.json se publica con status ok', () => {
+    const publico = JSON.parse(readFileSync(resolve(raiz, 'app/public/salud.json'), 'utf8'));
+    expect(publico.status).toBe('ok');
+  });
+});
+
+describe('volver atrás', () => {
+  it('readme-volver-atras: el README tiene la sección con un comando', () => {
+    const readme = readFileSync(resolve(raiz, 'README.md'), 'utf8');
+    expect(readme).toMatch(/^## Cómo volver atrás/m);
+    const seccion = readme.split(/^## Cómo volver atrás/m)[1];
+    expect(seccion).toMatch(/```bash\n[^`]*git checkout bf52c66/);
+  });
+});
+
+describe('registros', () => {
+  it('registros-sin-datos-personales: limpia correos y teléfonos', () => {
+    const limpio = limpiarDatosPersonales('falló para ana@correo.com tel +502 5555-1234');
+    expect(limpio).not.toContain('ana@correo.com');
+    expect(limpio).not.toMatch(/5555-1234/);
+  });
+
+  it('registros-sin-datos-personales: registrar no imprime datos personales', () => {
+    const espia = vi.spyOn(console, 'error').mockImplementation(() => {});
+    registrar('error', 'fallo con ana@correo.com', new Error('tel 5555-1234'));
+    const salida = JSON.stringify(espia.mock.calls);
+    expect(salida).not.toContain('ana@correo.com');
+    expect(salida).not.toContain('5555-1234');
+    espia.mockRestore();
+  });
+});
diff --git a/app/src/services/logger.ts b/app/src/services/logger.ts
new file mode 100644
index 0000000..e7dc619
--- /dev/null
+++ b/app/src/services/logger.ts
@@ -0,0 +1,15 @@
+const CORREO = /[\w.+-]+@[\w-]+(\.[\w-]+)+/g;
+const TELEFONO = /\+?\d[\d\s().-]{6,}\d/g;
+
+/** Reemplaza correos y teléfonos por marcas antes de escribir en consola. */
+export const limpiarDatosPersonales = (texto: string): string =>
+  texto.replace(CORREO, '[correo]').replace(TELEFONO, '[teléfono]');
+
+const aTexto = (valor: unknown): string =>
+  limpiarDatosPersonales(valor instanceof Error ? valor.message : String(valor));
+
+export const registrar = (nivel: 'warn' | 'error', mensaje: string, detalle?: unknown): void => {
+  const partes = [limpiarDatosPersonales(mensaje)];
+  if (detalle !== undefined) partes.push(aTexto(detalle));
+  console[nivel](...partes);
+};
