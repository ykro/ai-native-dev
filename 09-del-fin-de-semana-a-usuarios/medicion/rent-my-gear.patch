new file mode 100644
index 0000000..3d06768
--- /dev/null
+++ b/src/lib/logger.ts
@@ -0,0 +1,30 @@
+const EMAIL = /[^\s@]+@[^\s@]+\.[^\s@]+/g;
+const PHONE = /\+?\d[\d\s().-]{6,}\d/g;
+const PII_KEYS = /email|phone|telefono|name$|nombre|address|direccion/i;
+
+function scrub(text: string): string {
+  return text.replace(EMAIL, "[email]").replace(PHONE, "[telefono]");
+}
+
+/** Returns a copy of the value with personal data masked. */
+export function redact(value: unknown, key = ""): unknown {
+  if (typeof value === "string") {
+    return PII_KEYS.test(key) && key !== "gearName" ? "[oculto]" : scrub(value);
+  }
+  if (Array.isArray(value)) return value.map((v) => redact(v, key));
+  if (value && typeof value === "object") {
+    return Object.fromEntries(
+      Object.entries(value).map(([k, v]) => [k, redact(v, k)])
+    );
+  }
+  return value;
+}
+
+export function logInfo(message: string, data?: unknown): void {
+  console.log(scrub(message), data === undefined ? "" : redact(data));
+}
+
+export function logError(message: string, error?: unknown): void {
+  const detail = error instanceof Error ? error.message : error;
+  console.error(scrub(message), detail === undefined ? "" : redact(detail));
+}
