+});
diff --git a/src/lib/rateLimit.ts b/src/lib/rateLimit.ts
new file mode 100644
index 0000000..c423a1e
--- /dev/null
+++ b/src/lib/rateLimit.ts
@@ -0,0 +1,40 @@
+export interface RateLimiterOptions {
+  max: number;
+  windowMs: number;
+  now?: () => number;
+}
+
+export interface RateLimitResult {
+  allowed: boolean;
+  retryAfterSeconds: number;
+}
+
+/**
+ * Fixed-window limiter kept in memory, one counter per client key.
+ * Each server instance counts on its own.
+ */
+export function createRateLimiter({ max, windowMs, now = Date.now }: RateLimiterOptions) {
+  const windows = new Map<string, { start: number; count: number }>();
+
+  return {
+    check(key: string): RateLimitResult {
+      const t = now();
+      let entry = windows.get(key);
+      if (!entry || t - entry.start >= windowMs) {
+        entry = { start: t, count: 0 };
+        windows.set(key, entry);
+      }
+      entry.count += 1;
+      return {
+        allowed: entry.count <= max,
+        retryAfterSeconds: Math.max(1, Math.ceil((entry.start + windowMs - t) / 1000)),
+      };
+    },
+  };
+}
+
+/** Best-effort client key from proxy headers. */
+export function getClientKey(headers: Headers): string {
+  const forwarded = headers.get("x-forwarded-for")?.split(",")[0]?.trim();
+  return forwarded || headers.get("x-real-ip") || "unknown";
+}
