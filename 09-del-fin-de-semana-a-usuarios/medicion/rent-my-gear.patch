+vi.mock("@google/genai", () => ({
+  Modality: { IMAGE: "IMAGE", TEXT: "TEXT" },
+  GoogleGenAI: class {
+    models = { generateContent };
+  },
+}));
+vi.mock("@/config/env", () => ({
+  getEnv: () => ({ NANO_BANANA_API_KEY: "test-key" }),
+}));
+vi.mock("./storageService", () => ({ uploadImageFromBase64 }));
+vi.mock("./inventoryService", () => ({
+  getGearById: vi.fn().mockResolvedValue({
+    id: "g1",
+    name: "Canon EOS R5",
+    category: "fotografia-video",
+    description: "Cámara",
+    specs: {},
+    dailyRate: 500,
+    imageURL: null,
+  }),
+  updateGearImage: vi.fn(),
+}));
+
+describe("imageService - fallas del modelo", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    vi.spyOn(console, "log").mockImplementation(() => {});
+  });
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it("modelo-timeout: devuelve null sin subir nada cuando el modelo no responde a tiempo", async () => {
+    vi.useFakeTimers();
+    generateContent.mockReturnValue(new Promise(() => {})); // nunca responde
+    const { getOrGenerateImage } = await import("./imageService");
+
+    const pending = getOrGenerateImage("g1");
+    await vi.advanceTimersByTimeAsync(60_000);
+
+    await expect(pending).resolves.toBeNull();
+    expect(uploadImageFromBase64).not.toHaveBeenCalled();
+  });
+
+  it("modelo-respuesta-rota: devuelve null cuando la respuesta no trae imagen", async () => {
+    generateContent.mockResolvedValue({
+      candidates: [{ content: { parts: [{ text: "lo siento" }] } }],
+    });
+    const { getOrGenerateImage } = await import("./imageService");
+
+    await expect(getOrGenerateImage("g1")).resolves.toBeNull();
+    expect(uploadImageFromBase64).not.toHaveBeenCalled();
+  });
+
+  it("tope de salida: la llamada al modelo fija maxOutputTokens", async () => {
+    generateContent.mockResolvedValue({
+      candidates: [{ content: { parts: [{ inlineData: { data: "AAAA" } }] } }],
+    });
+    uploadImageFromBase64.mockResolvedValue("https://x/y.png");
+    const { getOrGenerateImage } = await import("./imageService");
+
+    await getOrGenerateImage("g1");
+
+    const config = generateContent.mock.calls[0][0].config;
+    expect(config.maxOutputTokens).toBeGreaterThan(0);
+  });
+});
