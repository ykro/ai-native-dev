+++ b/src/lib/rate-limit.test.ts
@@ -0,0 +1,21 @@
+import { describe, it, expect } from "vitest";
+import { createRateLimiter } from "./rate-limit";
+
+describe("createRateLimiter", () => {
+  it("limite-peticiones: bloquea al cliente que pasa el máximo y no afecta a otro", () => {
+    const limiter = createRateLimiter({ max: 2, windowMs: 1000, now: () => 0 });
+    expect(limiter.allow("a")).toBe(true);
+    expect(limiter.allow("a")).toBe(true);
+    expect(limiter.allow("a")).toBe(false);
+    expect(limiter.allow("b")).toBe(true);
+  });
+
+  it("limite-peticiones: vuelve a permitir al terminar la ventana", () => {
+    let now = 0;
+    const limiter = createRateLimiter({ max: 1, windowMs: 1000, now: () => now });
+    expect(limiter.allow("a")).toBe(true);
+    expect(limiter.allow("a")).toBe(false);
+    now = 1001;
+    expect(limiter.allow("a")).toBe(true);
+  });
+});
