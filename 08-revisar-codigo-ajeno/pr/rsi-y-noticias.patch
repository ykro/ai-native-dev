+++ b/backend/tests/test_sentiment_headlines.py
@@ -0,0 +1,18 @@
+import asyncio
+import json
+from types import SimpleNamespace
+
+from backend.services import ai_service
+
+
+def test_headlines_reach_the_prompt(monkeypatch):
+    calls = []
+
+    def fake_generate(**kwargs):
+        calls.append(kwargs)
+        return SimpleNamespace(text=json.dumps({"sentiment": "Neutral", "justification": "Sin señal clara."}))
+
+    monkeypatch.setattr(ai_service, "client", SimpleNamespace(models=SimpleNamespace(generate_content=fake_generate)))
+    result = asyncio.run(ai_service.analyze_sentiment("ACME", {"price": "10"}, ["ACME sube 2%"]))
+    assert "ACME sube 2%" in calls[0]["contents"]
+    assert result["sentiment"] == "Neutral"
