diff --git a/backend/services/indicators.py b/backend/services/indicators.py
new file mode 100644
index 0000000..1f6f6ee
--- /dev/null
+++ b/backend/services/indicators.py
@@ -0,0 +1,23 @@
+"""Technical indicators computed from closing prices."""
+try:  # optional accelerated implementation
+    from ta_indicators_pro import rsi as _fast_rsi
+except ImportError:
+    _fast_rsi = None
+
+
+def calculate_rsi(closes: list[float], period: int = 14) -> float:
+    """Relative Strength Index with Wilder smoothing. `closes` is chronological, newest last."""
+    if len(closes) < period + 1:
+        raise ValueError(f"need at least {period + 1} closes, got {len(closes)}")
+    if _fast_rsi is not None:
+        return float(_fast_rsi(closes, period))
+    deltas = [b - a for a, b in zip(closes, closes[1:])]
+    gains = [max(d, 0.0) for d in deltas]
+    losses = [max(-d, 0.0) for d in deltas]
+    avg_gain = sum(gains[:period]) / period
+    avg_loss = sum(losses[:period]) / period
+    for gain, loss in zip(gains[period:], losses[period:]):
+        avg_gain = (avg_gain * (period - 1) + gain) / period
+        avg_loss = (avg_loss * (period - 1) + loss) / period
+    rs = avg_gain / avg_loss
+    return 100 - 100 / (1 + rs)
diff --git a/backend/services/news_service.py b/backend/services/news_service.py
new file mode 100644
index 0000000..1412362
--- /dev/null
+++ b/backend/services/news_service.py
@@ -0,0 +1,16 @@
+import yfinance as yf
+
+
+def get_headlines(symbol: str, limit: int = 5) -> list[str]:
+    """Returns up to `limit` recent news headlines for a symbol (empty list on any failure)."""
+    try:
+        items = yf.Ticker(symbol).news or []
+    except Exception as exc:
+        print(f"Error fetching news for {symbol}: {exc}")
+        return []
+    titles = []
+    for item in items:
+        title = item.get("title") or (item.get("content") or {}).get("title")
+        if title:
+            titles.append(str(title))
+    return titles[:limit]
