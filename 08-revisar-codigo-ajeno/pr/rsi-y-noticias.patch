+from backend.services import news_service
+
+
+class FakeTicker:
+    def __init__(self, symbol):
+        self.news = [{"title": "Uno"}, {"content": {"title": "Dos"}}, {"title": "Tres"}]
+
+
+def test_get_headlines_limits_and_extracts(monkeypatch):
+    monkeypatch.setattr(news_service.yf, "Ticker", FakeTicker)
+    assert news_service.get_headlines("ACME", limit=2) == ["Uno", "Dos"]
+
+
+def test_get_headlines_returns_empty_on_failure(monkeypatch):
+    def boom(symbol):
+        raise RuntimeError("network down")
+
+    monkeypatch.setattr(news_service.yf, "Ticker", boom)
+    assert news_service.get_headlines("ACME") == []
