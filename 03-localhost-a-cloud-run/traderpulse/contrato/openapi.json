              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApi"
                }
              }
            },
            "description": "El símbolo no existe."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Obtener Historico",
        "tags": [
          "mercado"
        ]
      }
    },
    "/api/v1/instrumentos": {
      "get": {
        "operationId": "buscarInstrumentos",
        "parameters": [
          {
            "in": "query",
            "name": "q",
