                    "$ref": "#/components/schemas/Instrumento"
                  },
                  "title": "Response Buscarinstrumentos",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApi"
                }
              }
            },
            "description": "Token ausente o incorrecto."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Buscar Instrumentos",
        "tags": [
          "mercado"
        ]
      }
    },
