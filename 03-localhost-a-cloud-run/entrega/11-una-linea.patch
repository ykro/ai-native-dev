new file mode 100644
index 0000000..d379dc6
--- /dev/null
+++ b/traderpulse/frontend/Dockerfile
@@ -0,0 +1,25 @@
+# syntax=docker/dockerfile:1
+FROM node:24-slim AS deps
+WORKDIR /app
+COPY package.json package-lock.json ./
+RUN --mount=type=cache,target=/root/.npm npm ci
+
+FROM node:24-slim AS build
+WORKDIR /app
+ENV NEXT_TELEMETRY_DISABLED=1
+COPY --from=deps /app/node_modules ./node_modules
+COPY . .
+# API_URL y TRADERPULSE_TOKEN no entran al build: se leen en runtime (ver src/lib/api.ts).
+RUN npm run build
+
+FROM node:24-slim
+WORKDIR /app
+ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0
+# Salida standalone (next.config.ts): server.js + solo las dependencias que usa.
+COPY --from=build --chown=node:node /app/.next/standalone ./
+COPY --from=build --chown=node:node /app/.next/static ./.next/static
+USER node
+
+# Cloud Run inyecta PORT (8080 por defecto); Next lo lee del entorno.
+EXPOSE 8080
+CMD ["node", "server.js"]
