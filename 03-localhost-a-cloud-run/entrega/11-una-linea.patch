diff --git a/gcp/api.servicio.yaml b/gcp/api.servicio.yaml
new file mode 100644
index 0000000..8b15b75
--- /dev/null
+++ b/gcp/api.servicio.yaml
@@ -0,0 +1,50 @@
+# Despliegue: gcloud run services replace gcp/api.servicio.yaml --region ${REGION}
+# (sustituye las variables antes: envsubst < gcp/api.servicio.yaml)
+apiVersion: serving.knative.dev/v1
+kind: Service
+metadata:
+  name: traderpulse-api
+  labels:
+    app: traderpulse
+spec:
+  template:
+    metadata:
+      annotations:
+        autoscaling.knative.dev/minScale: "0"
+        autoscaling.knative.dev/maxScale: "5"
+    spec:
+      serviceAccountName: traderpulse-api@${PROJECT_ID}.iam.gserviceaccount.com
+      containerConcurrency: 40
+      timeoutSeconds: 60
+      containers:
+        - image: ${REGION}-docker.pkg.dev/${PROJECT_ID}/traderpulse/api:latest
+          ports:
+            - containerPort: 8080
+          env:
+            - name: SENTIMIENTO_FUENTE
+              value: vertex
+            - name: GOOGLE_CLOUD_PROJECT
+              value: ${PROJECT_ID}
+            - name: GOOGLE_CLOUD_LOCATION
+              value: global
+            # El token nunca va en claro: se resuelve desde Secret Manager al arrancar la instancia.
+            - name: TRADERPULSE_TOKEN
+              valueFrom:
+                secretKeyRef:
+                  name: traderpulse-token
+                  key: latest
+          resources:
+            limits:
+              cpu: "1"
+              memory: 512Mi
+          startupProbe:
+            httpGet:
+              path: /salud
+              port: 8080
+            periodSeconds: 3
+            failureThreshold: 10
+          livenessProbe:
+            httpGet:
+              path: /salud
+              port: 8080
+            periodSeconds: 30
diff --git a/gcp/web.servicio.yaml b/gcp/web.servicio.yaml
new file mode 100644
index 0000000..4abdf82
--- /dev/null
+++ b/gcp/web.servicio.yaml
@@ -0,0 +1,42 @@
+# Despliegue: gcloud run services replace gcp/web.servicio.yaml --region ${REGION}
+# Variables: ${PROJECT_ID}, ${REGION} y ${API_URL} (URL del servicio traderpulse-api, ya desplegado:
+#   gcloud run services describe traderpulse-api --region ${REGION} --format 'value(status.url)').
+apiVersion: serving.knative.dev/v1
+kind: Service
+metadata:
+  name: traderpulse-web
+  labels:
+    app: traderpulse
+spec:
+  template:
+    metadata:
+      annotations:
+        autoscaling.knative.dev/minScale: "0"
+        autoscaling.knative.dev/maxScale: "5"
+    spec:
+      serviceAccountName: traderpulse-web@${PROJECT_ID}.iam.gserviceaccount.com
+      containerConcurrency: 80
+      timeoutSeconds: 60
+      containers:
+        - image: ${REGION}-docker.pkg.dev/${PROJECT_ID}/traderpulse/web:latest
+          ports:
+            - containerPort: 8080
+          env:
+            # Ambos se leen en runtime desde el servidor de Next.js (src/lib/api.ts).
+            - name: API_URL
+              value: ${API_URL}
+            # Mismo secreto que el BFF: el servidor de Next lo manda en X-TraderPulse-Token.
+            - name: TRADERPULSE_TOKEN
+              valueFrom:
+                secretKeyRef:
+                  name: traderpulse-token
+                  key: latest
+          resources:
+            limits:
+              cpu: "1"
+              memory: 512Mi
+          startupProbe:
+            tcpSocket:
+              port: 8080
+            periodSeconds: 3
+            failureThreshold: 10
