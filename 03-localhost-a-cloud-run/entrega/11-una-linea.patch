diff --git a/traderpulse/backend/Dockerfile b/traderpulse/backend/Dockerfile
new file mode 100644
index 0000000..f4d0f3d
--- /dev/null
+++ b/traderpulse/backend/Dockerfile
@@ -0,0 +1,26 @@
+# syntax=docker/dockerfile:1
+FROM python:3.13-slim AS build
+COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
+ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
+WORKDIR /app
+
+# Dependencias primero: esta capa solo se reconstruye si cambia el lockfile.
+COPY pyproject.toml uv.lock ./
+RUN --mount=type=cache,target=/root/.cache/uv \
+    uv sync --frozen --no-dev --no-install-project
+
+# Paquete instalado (no editable): main.py lee su versión con importlib.metadata.
+COPY traderpulse_api ./traderpulse_api
+RUN --mount=type=cache,target=/root/.cache/uv \
+    uv sync --frozen --no-dev --no-editable
+
+FROM python:3.13-slim
+ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
+WORKDIR /app
+COPY --from=build /app/.venv /app/.venv
+RUN useradd --system --uid 10001 app
+USER app
+
+# Cloud Run inyecta PORT (8080 por defecto). TRADERPULSE_TOKEN llega desde Secret Manager.
+EXPOSE 8080
+CMD ["sh", "-c", "exec uvicorn traderpulse_api.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
