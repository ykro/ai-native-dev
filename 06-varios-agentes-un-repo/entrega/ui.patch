diff --git a/travelens/src/lib/plan-client.test.ts b/travelens/src/lib/plan-client.test.ts
new file mode 100644
index 0000000..6ea6ea3
--- /dev/null
+++ b/travelens/src/lib/plan-client.test.ts
@@ -0,0 +1,38 @@
+import { describe, it, expect, vi, afterEach } from "vitest";
+import { requestPlan } from "./plan-client";
+
+afterEach(() => vi.unstubAllGlobals());
+
+const plan = {
+  intro: "i",
+  days: [{ day: 1, title: "t", activities: ["a"], costUsd: 10 }],
+  hiddenGem: { title: "g", description: "d" },
+  localFood: { dish: "f", description: "d" },
+  totalUsd: 10,
+};
+
+function stub(ok: boolean, status: number, body: unknown) {
+  const fn = vi.fn(async () => ({ ok, status, json: async () => body }));
+  vi.stubGlobal("fetch", fn);
+  return fn;
+}
+
+describe("requestPlan", () => {
+  it("usa 3 días por defecto y devuelve el plan", async () => {
+    const fn = stub(true, 200, { plan });
+    expect(await requestPlan({ destination: "Antigua" })).toEqual(plan);
+    const init = (fn.mock.calls[0] as unknown as [string, { body: string }])[1];
+    expect(JSON.parse(init.body).days).toBe(3);
+  });
+
+  it("devuelve null con 502", async () => {
+    stub(false, 502, { error: "invalid_plan" });
+    expect(await requestPlan({ destination: "Antigua", days: 4 })).toBeNull();
+  });
+
+  it("devuelve null si fetch lanza", async () => {
+    vi.stubGlobal("fetch", vi.fn(async () => { throw new Error("red"); }));
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    expect(await requestPlan({ destination: "Antigua" })).toBeNull();
+  });
+});
diff --git a/travelens/src/lib/plan-client.ts b/travelens/src/lib/plan-client.ts
new file mode 100644
index 0000000..b8d61cf
--- /dev/null
+++ b/travelens/src/lib/plan-client.ts
@@ -0,0 +1,24 @@
+import type { BudgetPlan } from "@/lib/budget";
+
+export interface PlanRequest {
+  destination: string;
+  context?: string;
+  days?: number;
+}
+
+/** Pide el plan a /api/ai-plan. Devuelve null si el API falla o fetch lanza. */
+export async function requestPlan({ destination, context, days = 3 }: PlanRequest): Promise<BudgetPlan | null> {
+  try {
+    const res = await fetch("/api/ai-plan", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ destination, context, days }),
+    });
+    if (!res.ok) return null;
+    const data: { plan?: BudgetPlan } = await res.json();
+    return data.plan ?? null;
+  } catch (error) {
+    console.error("Failed to load plan", error);
+    return null;
+  }
+}
