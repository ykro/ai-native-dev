+import { describe, it, expect } from "vitest";
+import { applyBudget } from "./budget";
+
+const base = {
+  intro: "Intro",
+  days: [
+    { day: 1, title: "A", activities: ["x"], costUsd: 40 },
+    { day: 2, title: "B", activities: ["y"], costUsd: 25 },
+  ],
+  hiddenGem: { title: "g", description: "d" },
+  localFood: { dish: "p", description: "d" },
+};
+
+describe("applyBudget", () => {
+  it("suma los días e ignora el total del modelo", () => {
+    const r = applyBudget({ ...base, totalUsd: 999 });
+    expect(r.ok && r.plan.totalUsd).toBe(65);
+  });
+
+  it("acepta costo 0", () => {
+    const days = [{ ...base.days[0], costUsd: 0 }];
+    const r = applyBudget({ ...base, days });
+    expect(r.ok && r.plan.totalUsd).toBe(0);
+  });
+
+  it.each([-1, 1.5, "3", undefined, Number.NaN, Infinity])("rechaza costo %s", (cost) => {
+    const days = [{ ...base.days[0], costUsd: cost }];
+    expect(applyBudget({ ...base, days }).ok).toBe(false);
+  });
+
+  it.each([null, "x", [], {}, { ...base, days: [] }, { ...base, hiddenGem: null }])(
+    "rechaza forma inválida %#",
+    (plan) => {
+      expect(applyBudget(plan).ok).toBe(false);
+    },
+  );
+});
diff --git a/travelens/src/lib/budget.ts b/travelens/src/lib/budget.ts
new file mode 100644
index 0000000..71c21e6
--- /dev/null
+++ b/travelens/src/lib/budget.ts
@@ -0,0 +1,65 @@
+export interface BudgetDay {
+  day: number;
+  title: string;
+  activities: string[];
+  costUsd: number;
+}
+
+export interface BudgetPlan {
+  intro: string;
+  days: BudgetDay[];
+  hiddenGem: { title: string; description: string };
+  localFood: { dish: string; description: string };
+  totalUsd: number;
+}
+
+export type BudgetResult = { ok: true; plan: BudgetPlan } | { ok: false };
+
+function isRecord(v: unknown): v is Record<string, unknown> {
+  return typeof v === "object" && v !== null && !Array.isArray(v);
+}
+
+function isNonEmptyString(v: unknown): v is string {
+  return typeof v === "string" && v.trim().length > 0;
+}
+
+/**
+ * Valida el plan (cada día con costUsd entero >= 0) y calcula totalUsd como la
+ * suma de los días, ignorando el total que traiga el modelo.
+ */
+export function applyBudget(plan: unknown): BudgetResult {
+  if (!isRecord(plan) || !isNonEmptyString(plan.intro)) return { ok: false };
+  const { days, hiddenGem, localFood } = plan;
+  if (!Array.isArray(days) || days.length === 0) return { ok: false };
+  if (!isRecord(hiddenGem) || !isNonEmptyString(hiddenGem.title) || !isNonEmptyString(hiddenGem.description)) {
+    return { ok: false };
+  }
+  if (!isRecord(localFood) || !isNonEmptyString(localFood.dish) || !isNonEmptyString(localFood.description)) {
+    return { ok: false };
+  }
+
+  const parsedDays: BudgetDay[] = [];
+  for (const d of days) {
+    if (!isRecord(d)) return { ok: false };
+    const { day, title, activities, costUsd } = d;
+    if (typeof day !== "number" || !Number.isFinite(day)) return { ok: false };
+    if (!isNonEmptyString(title)) return { ok: false };
+    if (!Array.isArray(activities) || activities.length === 0 || !activities.every(isNonEmptyString)) {
+      return { ok: false };
+    }
+    if (typeof costUsd !== "number" || !Number.isInteger(costUsd) || costUsd < 0) return { ok: false };
+    parsedDays.push({ day, title, activities, costUsd });
+  }
+
+  const totalUsd = parsedDays.reduce((sum, d) => sum + d.costUsd, 0);
+  return {
+    ok: true,
+    plan: {
+      intro: plan.intro,
+      days: parsedDays,
+      hiddenGem: { title: hiddenGem.title, description: hiddenGem.description },
+      localFood: { dish: localFood.dish, description: localFood.description },
+      totalUsd,
+    },
+  };
+}
