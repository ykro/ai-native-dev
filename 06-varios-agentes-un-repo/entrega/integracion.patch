@@ -0,0 +1,24 @@
+import type { BudgetPlan } from "@/lib/budget";
+
+export interface PlanRequest {
+  destination: string;
+  context?: string;
+  days?: number;
+}
+
+/** Pide el plan a /api/ai-plan. Devuelve null si el API falla o fetch lanza. */
+export async function requestPlan({ destination, context, days = 3 }: PlanRequest): Promise<BudgetPlan | null> {
+  try {
+    const res = await fetch("/api/ai-plan", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ destination, context, days }),
+    });
+    if (!res.ok) return null;
+    const data: { plan?: BudgetPlan } = await res.json();
+    return data.plan ?? null;
+  } catch (error) {
+    console.error("Failed to load plan", error);
+    return null;
+  }
+}
