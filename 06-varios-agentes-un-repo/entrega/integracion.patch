+import { describe, it, expect, vi, afterEach } from "vitest";
+import { requestPlan } from "./plan-client";
+
+afterEach(() => vi.unstubAllGlobals());
+
+const plan = {
+  intro: "i",
+  days: [{ day: 1, title: "t", activities: ["a"], costUsd: 10 }],
+  hiddenGem: { title: "g", description: "d" },
+  localFood: { dish: "f", description: "d" },
+  totalUsd: 10,
+};
+
+function stub(ok: boolean, status: number, body: unknown) {
+  const fn = vi.fn(async () => ({ ok, status, json: async () => body }));
+  vi.stubGlobal("fetch", fn);
+  return fn;
+}
+
+describe("requestPlan", () => {
+  it("usa 3 días por defecto y devuelve el plan", async () => {
+    const fn = stub(true, 200, { plan });
+    expect(await requestPlan({ destination: "Antigua" })).toEqual(plan);
+    const init = (fn.mock.calls[0] as unknown as [string, { body: string }])[1];
+    expect(JSON.parse(init.body).days).toBe(3);
+  });
+
+  it("devuelve null con 502", async () => {
+    stub(false, 502, { error: "invalid_plan" });
+    expect(await requestPlan({ destination: "Antigua", days: 4 })).toBeNull();
+  });
+
+  it("devuelve null si fetch lanza", async () => {
+    vi.stubGlobal("fetch", vi.fn(async () => { throw new Error("red"); }));
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    expect(await requestPlan({ destination: "Antigua" })).toBeNull();
+  });
+});
